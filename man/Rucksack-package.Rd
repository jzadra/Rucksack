\name{Rucksack-package}
\alias{Rucksack}
\alias{Rucksack-package}
\docType{package}
\title{Carry R and RStudio Settings Between Computers}
\description{
Rucksack creates portable backups of user-level R and RStudio configuration
and restores them using paths discovered on the destination computer. On
Windows, it can also carry and install per-user fonts without administrator
rights and arrange for them to be loaded after each current-user login.
}
